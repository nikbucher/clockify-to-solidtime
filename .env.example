# Required service credentials. Never commit populated credentials.
CLOCKIFY_API_KEY=
SOLIDTIME_API_TOKEN=

# Optional target selection.
# Clockify uses the account's default workspace when this is empty.
CLOCKIFY_WORKSPACE_ID=
# Solidtime selects automatically only when the token has exactly one organization membership.
# Set this when memberships are ambiguous or to make the intended target explicit.
SOLIDTIME_ORGANIZATION_ID=

# Advanced overrides. Keep these production API defaults unless using a compatible deployment.
CLOCKIFY_BASE_URL=https://api.clockify.me/api/v1
SOLIDTIME_BASE_URL=https://app.solidtime.io/api
